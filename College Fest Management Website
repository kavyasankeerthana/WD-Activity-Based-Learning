
<!DOCTYPE html>
<html>
<head>
    <title>College Fest Management</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f0e8;
            color: #333333;
        }

        .heading {
            background-color: #542b2b;
            text-align: center;
            padding: 25px;
            border-bottom: 4px solid #c49a52;
        }

        .heading h1 {
            color: #e8c98a;
            font-size: 35px;
        }

        nav {
            background-color: #292525;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: #f5f0e8;
            text-decoration: none;
            margin: 12px;
            font-weight: bold;
        }

        nav a:hover {
            color: #d9b56d;
        }

        .banner {
            background-color: #795454;
            text-align: center;
            padding: 50px 20px;
            border-bottom: 3px solid #c49a52;
        }

        .banner h2 {
            color: #f1dba9;
            font-size: 32px;
        }

        .banner p {
            font-size: 18px;
            color: white;
        }

        .content {
            padding: 25px;
        }

        h2 {
            color: #754343;
            text-align: center;
        }

        .event-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 20px;
        }

        .event-card {
            background-color: #fffaf2;
            border: 2px solid #b58a64;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
        }

        .event-card h3 {
            color: #754343;
        }

        .event-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 8px;
        }

        .event-card p {
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: #fffaf2;
        }

        th, td {
            border: 2px solid #b58a64;
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #754343;
            color: white;
        }
        .coordinator {
            background-color: #fffaf2;
            padding: 15px;
            border: 2px solid #b58a64;
            border-radius: 8px;
        }
        .rules {
            background-color: #fffaf2;
            padding: 20px;
            border: 2px solid #b58a64;
            border-radius: 10px;
        }
        .rules li {
            padding: 8px;
        }
        form {
            background-color: #fffaf2;
            padding: 25px;
            max-width: 600px;
            margin: auto;
            border: 2px solid #b58a64;
            border-radius: 10px;
        }
        label {
            display: block;
            margin-top: 12px;
            font-weight: bold;
        }
        input, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 6px;
            box-sizing: border-box;
            border-radius: 5px;
            border: 1px solid #b58a64;
        }
        .event-choice {
            margin-top: 10px;
        }
        .event-choice input {
            width: auto;
        }

        button {
            background-color: #754343;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            margin-top: 18px;
            font-weight: bold;
            cursor: pointer;
        }

        .bottom {
            background-color: #292525;
            color: #f5f0e8;
            text-align: center;
            padding: 20px;
            margin-top: 20px;
        }

        @media screen and (max-width: 700px) {
            .event-container {
                grid-template-columns: 1fr;
            }

            nav a {
                display: block;
                margin: 10px;
            }

            .heading h1 {
                font-size: 27px;
            }

            .banner h2 {
                font-size: 25px;
            }

            .content {
                padding: 15px;
            }

            table {
                font-size: 12px;
            }

            th, td {
                padding: 7px;
            }
        }
    </style>
</head>

<body>

    <div class="heading">
        <h1>IGNITE 2026</h1>
        <p style="background-color: #f5f0e8;">Annual College Fest - Celebrate Talent, Creativity and Innovation!</p>
    </div>

    <nav>
        <a href="#home">Home</a>
        <a href="#events">Events</a>
        <a href="#schedule">Schedule</a>
        <a href="#coordinators">Coordinators</a>
        <a href="#rules">Rules</a>
        <a href="#register">Register</a>
    </nav>

    <div class="banner" id="home">
        <h2>WELCOME TO IGNITE 2026</h2>
        <p>Three Days of Fun, Learning, Competition and Celebration!</p>
        <p>Date: December 10 - 12, 2026</p>
        <p>Venue: College Campus</p>
    </div>

    <div class="content" id="events">
        <h2>OUR FEST EVENTS</h2>

        <h2>Technical Events</h2>

        <div class="event-container">

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=600" alt="Technology">
                <h3>Tech Quiz</h3>
                <p>Test your technical knowledge and problem-solving skills.</p>
                <p><b>Category:</b> Technical</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=600" alt="Coding">
                <h3>Code Challenge</h3>
                <p>Show your programming skills through coding challenges.</p>
                <p><b>Category:</b> Technical</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?w=600" alt="Project exhibition">
                <h3>Project Expo</h3>
                <p>Present your creative projects and innovative ideas.</p>
                <p><b>Category:</b> Technical</p>
            </div>

        </div>

        <h2>Cultural Events</h2>

        <div class="event-container">

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=600" alt="Music">
                <h3>Music Competition</h3>
                <p>Showcase your singing and musical talents.</p>
                <p><b>Category:</b> Cultural</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1504609813442-a8924e83f76e?w=600" alt="Dance">
                <h3>Dance Competition</h3>
                <p>Express yourself through energetic dance performances.</p>
                <p><b>Category:</b> Cultural</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600" alt="Art">
                <h3>Art Competition</h3>
                <p>Display your creativity through art and painting.</p>
                <p><b>Category:</b> Cultural</p>
            </div>

        </div>

        <h2>Workshops</h2>

        <div class="event-container">

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600" alt="AI workshop">
                <h3>AI Workshop</h3>
                <p>Learn the basics and applications of Artificial Intelligence.</p>
                <p><b>Category:</b> Workshop</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=600" alt="Leadership workshop">
                <h3>Leadership Workshop</h3>
                <p>Develop communication and leadership skills.</p>
                <p><b>Category:</b> Workshop</p>
            </div>

            <div class="event-card">
                <img src="https://images.unsplash.com/photo-1516321497487-e288fb19713f?w=600" alt="Web development">
                <h3>Web Development</h3>
                <p>Explore the fundamentals of creating websites.</p>
                <p><b>Category:</b> Workshop</p>
            </div>

        </div>
    </div>

    <div class="content" id="schedule">
        <h2>EVENT SCHEDULE</h2>

        <table>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Event</th>
                <th>Venue</th>
            </tr>

            <tr>
                <td>December 10</td>
                <td>9:00 AM</td>
                <td>Inauguration</td>
                <td>Main Auditorium</td>
            </tr>

            <tr>
                <td>December 10</td>
                <td>11:00 AM</td>
                <td>Tech Quiz</td>
                <td>Seminar Hall</td>
            </tr>

            <tr>
                <td>December 11</td>
                <td>10:00 AM</td>
                <td>AI Workshop</td>
                <td>Computer Lab</td>
            </tr>

            <tr>
                <td>December 11</td>
                <td>2:00 PM</td>
                <td>Dance Competition</td>
                <td>Main Stage</td>
            </tr>

            <tr>
                <td>December 12</td>
                <td>10:00 AM</td>
                <td>Project Expo</td>
                <td>Exhibition Hall</td>
            </tr>

            <tr>
                <td>December 12</td>
                <td>4:00 PM</td>
                <td>Prize Distribution</td>
                <td>Main Auditorium</td>
            </tr>
        </table>
    </div>

    <div class="content" id="coordinators">
        <h2>EVENT COORDINATORS</h2>

        <div class="event-container">

            <div class="coordinator">
                <h3>Technical Events</h3>
                <p><b>Contact:</b> 9876543210</p>
            </div>
            <div class="coordinator">
                <h3>Cultural Events</h3>
                <p><b>Contact:</b> 9876543120</p>
            </div>
            <div class="coordinator">
                <h3>Workshops</h3>
                <p><b>Contact:</b> 9876543102</p>
            </div>
        </div>
    </div>
    <div class="content" id="rules">
        <h2>FEST RULES AND REGULATIONS</h2>
        <div class="rules">
            <ol>
                <li>All participants must carry their college ID cards.</li>
                <li>Participants must register before the event begins.</li>
                <li>Maintain discipline and follow the instructions of coordinators.</li>
                <li>Participants must report to the venue on time.</li>
                <li>Any form of misconduct is strictly prohibited.</li>
                <li>The judges' decisions will be final.</li>
                <li>Maintain cleanliness throughout the campus.</li>
            </ol>
        </div>
    </div>

    <div class="content" id="register">
        <h2>FEST REGISTRATION FORM</h2>

        <form>
            <label>Full Name:</label>
            <input type="text" placeholder="Enter your name" required>

            <label>College Name:</label>
            <input type="text" placeholder="Enter your college name" required>

            <label>Roll Number:</label>
            <input type="text" placeholder="Enter your roll number" required>

            <label>Email Address:</label>
            <input type="email" placeholder="Enter your email" required>

            <label>Phone Number:</label>
            <input type="tel" placeholder="Enter your phone number" required>

            <label>Select Event Category:</label>

            <div class="event-choice">
                <input type="radio" name="category" value="Technical">
                Technical Events
            </div>

            <div class="event-choice">
                <input type="radio" name="category" value="Cultural">
                Cultural Events
            </div>

            <div class="event-choice">
                <input type="radio" name="category" value="Workshop">
                Workshops
            </div>

            <label>Select Event:</label>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Tech Quiz">
                Tech Quiz
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Code Challenge">
                Code Challenge
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Project Expo">
                Project Expo
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Music Competition">
                Music Competition
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Dance Competition">
                Dance Competition
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Art Competition">
                Art Competition
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="AI Workshop">
                AI Workshop
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Leadership Workshop">
                Leadership Workshop
            </div>

            <div class="event-choice">
                <input type="checkbox" name="event" value="Web Development">
                Web Development
            </div>

            <label>Additional Message:</label>
            <textarea rows="4" placeholder="Enter your message"></textarea>

            <button type="submit">Submit Registration</button>
            <button type="reset">Reset</button>
        </form>
    </div>

    <div class="bottom">
        <h3>IGNITE 2026 - College Fest</h3>
        <p>Celebrate Talent. Create Memories. Build Connections.</p>
        <p>© 2026 College Fest Management Website</p>
    </div>

</body>
</html>
